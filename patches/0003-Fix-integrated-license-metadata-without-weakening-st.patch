+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license in LICENSE.
+"""Strict integration metadata is a normal parser input, never an exclusion."""
+import pathlib
+import tempfile
+import unittest
+import licenses
+
+COMPONENTS = {
+    'third_party/catapult': 'catapult',
+    'third_party/perfetto/protos/third_party/android': 'perfetto_android',
+    'third_party/perfetto/protos/third_party/chromium': 'perfetto_chromium',
+    'third_party/rust': 'chromium_rust',
+    'third_party/rust-toolchain/lib/third_party/crubit': 'crubit',
+    'third_party/swiftshader/third_party/marl': 'marl',
+}
+
+class IntegrationMetadataTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = pathlib.Path(self.temp.name)
+        (self.root / 'LICENSE').write_text('fixture BSD license text')
+        self.fallbacks = self.root / 'tools/licenses/integration_metadata'
+        self.fallbacks.mkdir(parents=True)
+        for path, name in COMPONENTS.items():
+            (self.root / path).mkdir(parents=True)
+            (self.fallbacks / (name + '.README.chromium')).write_text(self.metadata('Integrated ' + name))
+
+    def metadata(self, name):
+        return ('Name: ' + name + '\nURL: https://example.test/project\n'
+                'Version: DEPS\nLicense: BSD-3-Clause\nLicense File: //LICENSE\nShipped: yes\n')
+
+    def parse(self, path):
+        return licenses.ParseDir(path, str(self.root), require_license_file=True, enable_warnings=True)
+
+    def test_all_six_checkout_paths_use_validated_metadata(self):
+        for path, name in COMPONENTS.items():
+            with self.subTest(path=path):
+                metadata, errors = self.parse(path)
+                self.assertEqual(errors, [])
+                self.assertEqual(len(metadata), 1)
+                self.assertEqual(metadata[0]['Name'], 'Integrated ' + name)
+                self.assertEqual(metadata[0]['License File'], ['LICENSE'])
+                self.assertTrue((self.root / metadata[0]['License File'][0]).is_file())
+
+    def test_dependency_metadata_takes_precedence(self):
+        path = 'third_party/catapult'
+        (self.root / path / 'README.chromium').write_text(self.metadata('Upstream'))
+        metadata, errors = self.parse(path)
+        self.assertEqual(errors, [])
+        self.assertEqual([m['Name'] for m in metadata], ['Upstream'])
+
+    def test_bad_upstream_is_not_replaced_by_good_fallback(self):
+        path = 'third_party/catapult'
+        for contents in ('', 'Name: Incomplete\n'):
+            with self.subTest(contents=contents):
+                (self.root / path / 'README.chromium').write_text(contents)
+                metadata, errors = self.parse(path)
+                self.assertFalse(metadata)
+                self.assertTrue(errors)
+
+    def test_missing_fallback_remains_fatal(self):
+        (self.fallbacks / 'catapult.README.chromium').unlink()
+        with self.assertRaises(licenses.LicenseError):
+            self.parse('third_party/catapult')
+
+    def test_missing_referenced_license_remains_fatal(self):
+        (self.root / 'LICENSE').unlink()
+        metadata, errors = self.parse('third_party/catapult')
+        self.assertFalse(metadata)
+        self.assertTrue(errors)
+
+    def test_unknown_checkout_has_no_general_fallback(self):
+        path = 'third_party/unregistered'
+        (self.root / path).mkdir()
+        with self.assertRaises(licenses.LicenseError):
+            self.parse(path)
+
+    def test_crashpad_uses_existing_chromium_dependency_licenses(self):
+        source = pathlib.Path(licenses.__file__).resolve().parents[2]
+        for name, expected in [('lss', 'third_party/lss/linux_syscall_support.h'),
+                               ('zlib', 'third_party/zlib/LICENSE')]:
+            with self.subTest(component=name):
+                metadata, errors = licenses.ParseDir('third_party/crashpad/crashpad/third_party/' + name,
+                                                     str(source), require_license_file=True)
+                self.assertEqual(errors, [])
+                self.assertEqual(metadata[0]['License File'], [expected])
+                self.assertTrue((source / expected).is_file())
+
+if __name__ == '__main__':
+    unittest.main()
